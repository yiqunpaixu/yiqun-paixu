{"section":{"id":"cet4-2025-06-set1-news-report-2","examId":"cet4-2025-06-set1","title":"新闻 2","kind":"新闻","start":162.83,"end":224.75,"preview":"Two arrests were announced Thursday.","lines":[{"start":162.83,"end":165.79,"text":"Two arrests were announced Thursday."},{"start":165.79,"end":179.71,"text":"The arrests were in connection with a string of mail thefts from U.S. Post Service's collection boxes in Marion County, and for the possession of a stolen postal key, according to the Department of Justice."},{"start":179.71,"end":194.43,"text":"Jordan Jax and Tarrod Goodman, both 23, were arrested after evidence gathered in an investigation showed the pair stole mail on multiple occasions using a postal key, according to a news release."},{"start":194.43,"end":198.83,"text":"Jax and Goodman stole mail for around four months."},{"start":198.83,"end":202.75,"text":"Investigators reviewed videos of the collection boxes."},{"start":202.75,"end":208.19,"text":"The video showed the two men loading the stolen mail into Jax's vehicle."},{"start":208.19,"end":215.23,"text":"Investigators were also able to recover the key that was used to open the collection boxes."},{"start":215.23,"end":224.75,"text":"Jax and Goodman each face up to five years in federal prison in the mail thefts and up to ten years for possession of the postal key."}],"audio":"assets/audio/70a4d5d236e308119fbcc76b8c1b3b128e42d5f6ef0bbfebca4117a3ea1177bb.wav","audioOffset":162.83},"tasks":[{"id":"0-0","text":"Two arrests were announced Thursday.","start":162.83,"end":165.79,"legacyTaskIds":["0-0"],"legacyTaskIndices":[0],"sentenceVisual":{"type":"事件","icon":"shapes","image":"assets/images/bf3b8073bbada98d2d6bad72de86d2de3b2afb388b2c21e10bef41918f5dd045.webp","alt":"宣布逮捕的情境"},"chunks":[{"text":"Two arrests were announced Thursday.","start":162.83,"end":165.79,"visual":{"type":"事件","icon":"shapes","image":"assets/images/bf3b8073bbada98d2d6bad72de86d2de3b2afb388b2c21e10bef41918f5dd045.webp","alt":"宣布逮捕的情境"}}]